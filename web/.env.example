# Copy to .env and fill in. Never commit .env.

# Neon: pooled connection string (host contains "-pooler") for the app,
# and the direct one for migrations. Locally both can point at the same DB.
DATABASE_URL="postgresql://gym:gym@localhost:5432/gym_tracker"
DATABASE_URL_UNPOOLED="postgresql://gym:gym@localhost:5432/gym_tracker"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Optional: comma-separated emails allowed to create an account.
# Leave empty to allow anyone to sign up.
ALLOWED_EMAILS=""

# Integration tests only: a database the tests may wipe.
TEST_DATABASE_URL="postgresql://gym:gym@localhost:5432/gym_tracker_test"
