// Auth models (User, Session, Account, Verification) were generated by the
// Better Auth CLI (`npm run auth:generate`); keep their fields in sync with it.
// Everything a user logs is owned by a User and deleted with it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id
  name             String
  email            String
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  /// Unit new sets default to: "lb" or "kg". Synced last-write-wins.
  defaultUnit      String            @default("lb")
  /// Attendance grid length: "3m" or "6m".
  attendanceRange  String            @default("3m")
  /// Start of a fixed attendance window as YYYY-MM-DD; null = ending today.
  attendanceStart  String?
  /// What to train each weekday (src/lib/plan.ts); null = no plan yet.
  weeklyPlan       Json?
  /// Weeks saved as templates (src/lib/plan.ts); null = none.
  planTemplates    Json?
  sessions         Session[]
  accounts         Account[]
  passkeys         Passkey[]
  exercises        Exercise[]
  workouts         Workout[]
  workoutExercises WorkoutExercise[]
  sets             ExerciseSet[]
  syncMutations    SyncMutation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Passkeys (Better Auth passkey plugin): WebAuthn credentials for Face ID / Touch ID sign-in.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

/// Better Auth rate-limit counters (rateLimit.storage = "database").
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

enum WeightUnit {
  lb
  kg
}

// Sync columns on the four user-data tables (see docs/OFFLINE-PLAN.md):
// - version: bumped on every update by the `sync_bump` trigger; clients send
//   the version they edited as `baseVersion` to detect conflicting edits.
// - seq: a database-wide change counter set by the same trigger on every
//   insert/update; /api/sync/pull returns rows with seq above the client's cursor.
// - deletedAt: deletions are kept as tombstones so other devices learn about them.
// Ids may be created on the device (UUIDs), so creates are safe to retry.
// Child tables carry userId too, for per-user pulls and ownership checks.

model Exercise {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// Free text, e.g. "Chest". Suggestions come from defaults plus names in use.
  muscleGroup String?
  videoUrl    String?
  /// Hidden from pickers. Exercises with history are archived instead of deleted.
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)
  seq         BigInt    @default(0)
  deletedAt   DateTime?

  workoutExercises WorkoutExercise[]

  /// Names are unique per user, case-insensitively, among live exercises:
  /// enforced in src/server/sync.ts under the per-user write lock.
  @@index([userId, seq])
  @@map("exercise")
}

/// One gym session. endedAt null = in progress.
model Workout {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(1)
  seq       BigInt    @default(0)
  deletedAt DateTime?

  exercises WorkoutExercise[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, seq])
  @@map("workout")
}

/// An exercise performed within a workout, in the order it was added.
model WorkoutExercise {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId  String
  workout    Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  position   Int
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  version    Int       @default(1)
  seq        BigInt    @default(0)
  deletedAt  DateTime?

  sets ExerciseSet[]

  @@index([workoutId])
  @@index([exerciseId])
  @@index([userId, seq])
  @@map("workout_exercise")
}

/// One logged set. Weight is stored exactly as entered with its unit; null =
/// bodyweight. A timed set has durationSec and may have no reps.
model ExerciseSet {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  position          Int
  weight            Float?
  unit              WeightUnit
  reps              Int?
  durationSec       Int?
  rpe               Float?
  notes             String?
  completedAt       DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  version           Int             @default(1)
  seq               BigInt          @default(0)
  deletedAt         DateTime?

  @@index([workoutExerciseId])
  @@index([userId, seq])
  @@map("exercise_set")
}

/// Mutations already applied by /api/sync/push, so a retried push is answered
/// with the stored result instead of being applied twice. Pruned after 30 days.
model SyncMutation {
  userId    String
  id        String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  result    Json
  appliedAt DateTime @default(now())

  @@id([userId, id])
  @@index([appliedAt])
  @@map("sync_mutation")
}
